# Copy this file to .env in the same directory. docker compose reads .env
# and substitutes the values below. Each default matches docker-compose.yml.

# Port published on the host, and the port the process listens on inside the container.
HTTP_PORT=8080
CONTAINER_PORT=8080

# Source identifier returned by GET /api/information.
# The name passed to `winget source add -n` is chosen on the client.
SERVER_NAME=winget-restsource-self-hosted

# SQLite file inside the container. DATA_DIR is a named volume, or a host path such as ./data.
DATABASE_PATH=/data/winget.db
DATA_DIR=winget-data

# Log file inside the container. The file is appended and is not rotated.
# LOG_DIR is a named volume, or a host path such as ./logs.
LOG_FILE=/logs/winget-restsource.log
LOG_DIR=winget-logs
LOG_LEVEL=Information
ASPNET_LOG_LEVEL=Warning

# Empty allows POST, PUT, and DELETE without a key. Set a secret to require the X-Api-Key header.
API_KEY=

ASPNETCORE_ENVIRONMENT=Production

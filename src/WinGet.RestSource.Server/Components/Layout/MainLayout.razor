@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="@LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentLayoutHamburger />
            <FluentText Weight="TextWeight.Bold" Size="TextSize.Size400">
                WinGet REST Source
            </FluentText>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Navigation" Width="250px">
        <FluentNav Padding="@Padding.All2" Style="height: 100%;">
            <FluentNavItem Href="/"
                           Match="NavLinkMatch.All"
                           IconRest="@(new Icons.Regular.Size20.AppsList())">
                Catalog
            </FluentNavItem>
            <FluentNavItem Href="/admin"
                           IconRest="@(new Icons.Regular.Size20.Board())">
                Dashboard
            </FluentNavItem>
            <FluentNavItem Href="/admin/packages"
                           IconRest="@(new Icons.Regular.Size20.Box())">
                Manage packages
            </FluentNavItem>
        </FluentNav>
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Content" Padding="@Padding.All3">
        @Body
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Footer">
        Self-hosted WinGet REST source
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="@LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12px">
            <FluentLayoutHamburger />
            <FluentIcon Value="@(new Icons.Regular.Size24.Box())" Color="Color.Primary" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <FluentText Weight="TextWeight.Bold">WinGet REST Source</FluentText>
                <FluentText Size="TextSize.Size200">Self-hosted package catalog</FluentText>
            </FluentStack>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Navigation" Width="240px">
        <FluentNav Padding="@Padding.All2" Style="height: 100%;">
            <FluentNavSectionHeader Title="Browse" />
            <FluentNavItem Href="/"
                           Match="NavLinkMatch.All"
                           IconRest="@(new Icons.Regular.Size20.AppsList())">
                Catalog
            </FluentNavItem>
            <FluentNavSectionHeader Title="Manage" />
            <FluentNavItem Href="/admin"
                           IconRest="@(new Icons.Regular.Size20.Board())">
                Dashboard
            </FluentNavItem>
            <FluentNavItem Href="/admin/packages"
                           IconRest="@(new Icons.Regular.Size20.BoxMultiple())">
                Packages
            </FluentNavItem>
        </FluentNav>
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Content" Padding="@Padding.All4">
        <div class="page">
            @Body
        </div>
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Footer">
        <FluentText Size="TextSize.Size200">REST API at /api · SQLite · Fluent UI 5</FluentText>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

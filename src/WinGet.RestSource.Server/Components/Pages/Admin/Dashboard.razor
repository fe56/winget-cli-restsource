@page "/admin"
@using Microsoft.WinGet.RestSource.Utils.Models.Schemas
@inject PackageCatalogService Catalog
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
    <div class="page-header">
        <FluentText Weight="TextWeight.Bold" Size="TextSize.Size600">Dashboard</FluentText>
        <FluentText>Source status and the command winget uses to connect.</FluentText>
    </div>

    @if (isLoading)
    {
        <FluentSpinner />
    }
    else
    {
        <div class="stat-row">
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                    <FluentText>Packages</FluentText>
                    <FluentText Weight="TextWeight.Bold" Size="TextSize.Size700">@packageCount</FluentText>
                </FluentStack>
            </FluentCard>
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                    <FluentText>Status</FluentText>
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Content="Online" />
                </FluentStack>
            </FluentCard>
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                    <FluentText>Source identifier</FluentText>
                    <FluentText Weight="TextWeight.Semibold">@sourceIdentifier</FluentText>
                </FluentStack>
            </FluentCard>
        </div>

        <SourceCommand />

        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                <FluentText Weight="TextWeight.Semibold">REST versions this server accepts</FluentText>
                <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8px">
                    @foreach (var version in supportedVersions)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Outline" Content="@version" />
                    }
                </FluentStack>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Navigation.NavigateTo("/admin/packages"))">
                        Manage packages
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => Navigation.NavigateTo("/"))">
                        Browse catalog
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }
</FluentStack>

@code {
    private int packageCount;
    private bool isLoading = true;
    private string sourceIdentifier = string.Empty;
    private IReadOnlyList<string> supportedVersions = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            packageCount = await Catalog.CountAsync();
            var information = new Information();
            sourceIdentifier = information.SourceIdentifier;
            supportedVersions = information.ServerSupportedVersions?.ToList() ?? new List<string>();
        }
        catch
        {
            packageCount = 0;
            sourceIdentifier = "unavailable";
        }
        finally
        {
            isLoading = false;
        }
    }
}

@page "/admin/packages"
@using Microsoft.WinGet.RestSource.Utils.Models.Schemas
@inject PackageCatalogService Catalog
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Manage packages</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
    <FluentText Weight="TextWeight.Bold" Size="TextSize.Size600">Packages</FluentText>

    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px">
        <FluentTextInput @bind-Value="searchQuery"
                         Placeholder="Search packages"
                         Style="flex: 1;"
                         ChangeAfterKeyPress="@([KeyPress.For(KeyCode.Enter)])"
                         OnChangeAfterKeyPress="OnSearchKeyPress">
            <StartTemplate>
                <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />
            </StartTemplate>
        </FluentTextInput>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SearchAsync">Search</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Navigation.NavigateTo("/admin/packages/new"))">
            Add package
        </FluentButton>
    </FluentStack>

    @if (isLoading)
    {
        <FluentSpinner />
    }
    else if (showError)
    {
        <FluentMessageBar Title="Error" Intent="@MessageBarIntent.Error">@errorMessage</FluentMessageBar>
    }
    else if (packages.Count == 0)
    {
        <FluentCard>
            <FluentText>No packages found. Add your first package to get started.</FluentText>
        </FluentCard>
    }
    else
    {
        <FluentDataGrid Items="@packages.AsQueryable()" Pagination="@pagination" TGridItem="PackageManifest">
            <PropertyColumn Property="@(p => p.PackageIdentifier)" Title="Package identifier" Sortable="true" />
            <TemplateColumn Title="Name">
                @GetPackageName(context)
            </TemplateColumn>
            <TemplateColumn Title="Versions">
                @(context.Versions?.Count ?? 0)
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  OnClick="@(() => Navigation.NavigateTo($"/admin/packages/{Uri.EscapeDataString(context.PackageIdentifier)}"))">
                        View
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Color="Color.Error"
                                  OnClick="@(() => DeletePackageAsync(context.PackageIdentifier))">
                        Delete
                    </FluentButton>
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>

        <FluentPaginator State="@pagination" />
    }
</FluentStack>

@code {
    private List<PackageManifest> packages = new();
    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private bool showError;
    private string errorMessage = string.Empty;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 20 };

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
    }

    private async Task OnSearchKeyPress(FluentKeyPressEventArgs _)
    {
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        isLoading = true;
        showError = false;
        try
        {
            var result = await Catalog.SearchAsync(searchQuery);
            packages = result.ToList();
        }
        catch (Exception ex)
        {
            packages = new List<PackageManifest>();
            showError = true;
            errorMessage = PackageCatalogService.GetErrorMessage(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeletePackageAsync(string packageIdentifier)
    {
        var result = await DialogService.ShowConfirmationAsync(
            $"Delete package '{packageIdentifier}'? This cannot be undone.",
            "Delete package",
            "Delete",
            "Cancel");

        if (result.Cancelled)
        {
            return;
        }

        try
        {
            await Catalog.DeleteAsync(packageIdentifier);
            await SearchAsync();
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = PackageCatalogService.GetErrorMessage(ex);
        }
    }

    private static string GetPackageName(PackageManifest manifest)
    {
        return manifest.Versions?.FirstOrDefault()?.DefaultLocale?.PackageName ?? manifest.PackageIdentifier;
    }
}
